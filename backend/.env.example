# Copy this file to .env and fill in real values. Never commit .env.

# Required for the chat/conversation feature (console.anthropic.com)
ANTHROPIC_API_KEY=

# Model to use for conversation (tool-use capable)
ANTHROPIC_MODEL=claude-sonnet-5

# Shared secret checked against the X-Webhook-Token header sent by
# Health Auto Export. Pick any long random string.
HEALTH_WEBHOOK_SECRET=changeme

# Read-only ICS/webcal feed URL from TimeTree's "Calendar sharing" feature.
TIMETREE_ICS_URL=

# Optional
JARVIS_PORT=8000
DEFAULT_WEATHER_LOCATION=Berlin
